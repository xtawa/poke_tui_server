NODE_ENV=production
HOST=0.0.0.0
PORT=3000
PUBLIC_BASE_URL=https://poke.example.com
POKE_API_KEY=replace-with-poke-v2-api-key
MCP_SHARED_SECRET=replace-with-at-least-32-random-characters
DEVICE_ENROLLMENT_SECRET=replace-with-at-least-32-random-characters
DATABASE_PATH=/data/poke.db
LOG_LEVEL=info
MAX_MESSAGE_LENGTH=16384
WS_HEARTBEAT_INTERVAL=30000
POKE_REPLY_TIMEOUT_MS=180000
DEVICE_OFFLINE_QUEUE_LIMIT=100
POKE_USER_ID_ALLOWLIST=
STORE_MESSAGE_CONTENT=false
TRUST_PROXY=false
ALLOW_WS_QUERY_TOKEN=false
